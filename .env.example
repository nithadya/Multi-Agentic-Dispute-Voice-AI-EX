# ============================================================================
# .env.example — copy this to `.env` and fill in your own values.
#   cp .env.example .env
# NEVER commit your real .env (it is git-ignored). These are placeholders only.
# See student_docs/STUDENT_SETUP_GUIDE.pdf for the full setup walkthrough.
# ============================================================================

# ============================================================================
# Qdrant Cloud (RAG vector storage) — https://cloud.qdrant.io
# ============================================================================
QDRANT_API_KEY=<your-qdrant-api-key>
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_COLLECTION_NAME=dispute_ai

# ============================================================================
# Database & Cache — Supabase (Postgres + pgvector) + Redis
# ============================================================================
# Use port 6543 (transaction-mode pooler), NOT 5432 (caps at 15 clients).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>
# Local Docker Compose: redis://redis:6379/0  ·  Local bare: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# LLM Providers
# ============================================================================
OPENROUTER_API_KEY=<your-openrouter-key>
OPENAI_API_KEY=<your-openai-key>
GROQ_API_KEY=<your-groq-key>
ANTHROPIC_API_KEY=<your-anthropic-key>
GOOGLE_API_KEY=<your-google-ai-studio-key>


# Neo4j Graph Database (Graph RAG — Week 11 inspired)
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ============================================================================
# External APIs — web search
# ============================================================================
TAVILY_API_KEY=<your-tavily-key>

# ============================================================================
# Observability — Langfuse (https://cloud.langfuse.com)
# ============================================================================
LANGFUSE_SECRET_KEY=<your-langfuse-secret-key>
LANGFUSE_PUBLIC_KEY=<your-langfuse-public-key>
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ============================================================================
# Voice Pipeline — LiveKit Cloud + Deepgram (STT) + ElevenLabs (TTS)
# ============================================================================
# LiveKit credentials: https://cloud.livekit.io
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_SECRET=<your-livekit-api-secret>
# Deepgram (speech-to-text): https://console.deepgram.com
DEEPGRAM_API_KEY=<your-deepgram-key>
# ElevenLabs (text-to-speech): https://elevenlabs.io/app/settings/api-keys
ELEVEN_API_KEY=<your-elevenlabs-key>